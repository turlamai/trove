<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name        "trove">
<!ENTITY author      "turlamai">
<!ENTITY version     "2026.12.17">
<!ENTITY github      "turlamai/trove">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/&github;/main/trove.plg">
<!ENTITY packageFile "trove-&version;-x86_64-1.txz">
<!ENTITY packageURL  "https://github.com/&github;/releases/download/v&version;/&packageFile;">
<!ENTITY packageSHA  "8491b5628083625c566ec6a4c9656f048f1102dc01d7a985198e4bfa41c7d6bc">
<!ENTITY pluginLOC   "/boot/config/plugins/&name;">
<!ENTITY emhttpLOC   "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="Tools/trove"
        pluginURL="&pluginURL;"
        icon="folder-open"
        min="7.0.0"
        project="https://github.com/&github;"
        readme="https://github.com/&github;#readme"
        support="https://github.com/&github;/issues">

<CHANGES>
### 2026.12.17
- Fix: the share dialog received the inspector's parent-directory path
  instead of the selected file, so creating a link from the UI always
  targeted an empty path.
- Add the missing UI entry for folder ZIP download (inspector action);
  daemon and gateway support already shipped in 2026.12.15.
- Share dialog no longer hardcodes a port comparison and warns when the
  public share listener is disabled.

### 2026.12.16
- Development preview: shares-first file browsing, optional dual-pane,
  storage-safety checks (namespace mixing refused), background jobs with
  staging → verify → atomic commit, task center, zh-CN/en UI.
- Read-only until a job data directory is configured (Settings → Trove).
- First real-machine acceptance pass on Unraid 7.3.3: install/upgrade
  chain, security matrix, copy integrity (SHA-256 verified) — see
  docs/acceptance/ in the repository.
</CHANGES>

<!--
  Pre-install: keep only the current package cache on the flash drive.
-->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &pluginLOC;
rm -f $(ls &pluginLOC;/trove-*.txz 2>/dev/null | grep -v '&packageFile;' | grep -v '^$')
exit 0
</INLINE>
</FILE>

<!--
  Package: downloaded from the versioned GitHub release, SHA-256 verified,
  installed with Slackware package tooling.
-->
<FILE Name="&pluginLOC;/&packageFile;" Run="upgradepkg --install-new">
<URL>&packageURL;</URL>
<SHA256>&packageSHA;</SHA256>
</FILE>

<!--
  Post-install: refresh page registration and start the daemon detached.
-->
<FILE Run="/bin/bash">
<INLINE>
# (XML special characters are escaped for the plugin parser)
# --restart: the upgrade replaced the binary; a live daemon keeps its old
# inode, so post-install must bounce the process to run the new code.
/usr/local/emhttp/plugins/trove/scripts/start-daemon.sh --restart &gt;/dev/null 2&gt;&amp;1 &amp;
echo ""
echo "------------------------------------------------------------"
echo " Trove has been installed."
echo " Open it under Tools → Trove. Settings → Trove for configuration."
echo "------------------------------------------------------------"
echo ""
exit 0
</INLINE>
</FILE>

<!--
  Update: remove stale files from previous layouts before reinstalling.
-->
<FILE Run="/bin/bash" Method="update">
<INLINE>
# remove stale binaries from previous layouts (post-install does the restart)
rm -f /usr/local/sbin/troved
exit 0
</INLINE>
</FILE>

<!--
  Remove: stop the daemon, remove the package; keep user settings on flash
  and keep any configured job data directory (user data is never deleted).
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
pkill -TERM -x troved 2>/dev/null
sleep 1
removepkg trove-&version;-x86_64-1 2>/dev/null || true
rm -f &pluginLOC;/trove-*.txz
rm -rf /run/trove
echo ""
echo " Trove removed. Settings kept in &pluginLOC;/trove.cfg;"
echo " delete that file and your job data directory manually if desired."
echo ""
exit 0
</INLINE>
</FILE>

</PLUGIN>
